# trybondi.app: site-wide server rules (Hostinger runs Apache-compatible LiteSpeed).
# If Hostinger already put a .htaccess in public_html, merge these rules into it rather than replacing it.

# One address for every page: https://trybondi.app, without www.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.trybondi\.app$ [NC]
RewriteRule ^ https://trybondi.app%{REQUEST_URI} [R=301,L]

# Hostinger's Git deploy serves this repository's top level, so the repository's own public_html folder (the readable
# source of the same pages) would also answer at /public_html/...: send those addresses to the real pages.
RewriteCond %{REQUEST_URI} ^/public_html(/.*)?$
RewriteRule ^ https://trybondi.app%1 [R=301,L]

# Missing pages get Bondi's own page, still with a real 404 status.
ErrorDocument 404 /404.html

# Files that are notes for us, not pages for visitors (SKILL.md and the like), are never served.
<FilesMatch "\.(md|sql|log|bak|sh|ini|env|lock)$">
  Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
AddCharset utf-8 .txt .xml .webmanifest

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Report-only for now: the browser console lists anything it would block, nothing is blocked yet.
  # Once the buy page's Paddle checkout shows no reports, rename this header to Content-Security-Policy.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.paddle.com https://*.paddle.com; style-src 'self' 'unsafe-inline' https://*.paddle.com; img-src 'self' data: https://*.paddle.com; font-src 'self'; connect-src 'self' https://*.paddle.com; frame-src https://*.paddle.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Images, films and fonts are cached by browsers; pages are always checked for a newer version.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# The films, their phone copies and their first frames: a year. Pages ask for them with ?v=<content hash> (dev/build-site.php stamps it
# into the served copy), so a new render is a new address and is seen at once.
<FilesMatch "^bondi-[a-z]+(-poster|-small|-hd)?\.(mp4|jpg|png)$">
  <IfModule mod_expires.c>
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>
